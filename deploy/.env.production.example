# Copy to deploy/.env.production. Do not commit the copied file.
# Use OCI Vault to inject these values on the server, not a source-controlled secret.
DOMAIN=app.example.com
AUTH_TOKEN_SECRET=replace-with-a-random-64-character-secret
POSTGRES_PASSWORD=replace-with-a-random-32-character-password

# Optional external observability endpoints. Leave unset to use the bundled stack.
# TEMPO_URL=http://tempo:3200
# PROMETHEUS_URL=http://prometheus:9090
